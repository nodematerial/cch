# progress <label> <done> <total> <started at, in $SECONDS> [detail]
# Redraws one line on the terminal (stderr). Does nothing when stderr is not a terminal
progress() {
  [ -t 2 ] || return 0
  local label="$1" done="$2" total="$3" started="$4" detail="${5:-}"
  local width=30 filled pct elapsed eta="" bar
  filled=$(( done * width / total ))
  pct=$(( done * 100 / total ))
  bar=$(printf '%*s' "$filled" '' | sed 's/ /█/g')$(printf '%*s' $(( width - filled )) '' | sed 's/ /░/g')
  elapsed=$(( SECONDS - started ))
  if [ "$done" -gt 0 ] && [ "$done" -lt "$total" ]; then
    local left=$(( elapsed * (total - done) / done ))
    eta="  $T_ETA $(( left / 60 )):$(printf '%02d' $(( left % 60 )))"
  fi
  # Keep the detail short so the line does not wrap
  [ "${#detail}" -gt 40 ] && detail="${detail:0:39}…"
  printf '\r\033[K%s %s %*d/%d %3d%%%s  %s' "$label" "$bar" "${#total}" "$done" "$total" "$pct" "$eta" "$detail" >&2
}

# Extract only user prompts and Claude's reply text; skip tool results, system reminders, etc.
extract_dialogue() {
  jq -r '
    def text_of: if type == "string" then . else (map(select(.type == "text") | .text) | join("\n")) end;
    select(.isSidechain != true and .isMeta != true)
    | if .type == "user" then (.message.content | text_of) as $t
        | select($t != "" and ($t | startswith("<") | not)) | "U: " + $t[0:800]
      elif .type == "assistant" then (.message.content | if type == "array" then text_of else "" end) as $t
        | select($t != "") | "A: " + $t[0:800]
      else empty end
  ' "$1" 2>/dev/null
}

# Conversations with no summary or a summary older than the conversation, newest first
summary_targets() {
  local f out
  "${MTIME_LIST[@]}" "$PROJECTS_DIR"/*/*.jsonl 2>/dev/null | sort -rn | while IFS=$'\t' read -r _ f; do
    out="$SUMMARY_DIR/$(basename "$f" .jsonl).txt"
    [ -f "$out" ] && [ "$out" -nt "$f" ] && continue
    echo "$f"
  done
}

summarize() {
  local limit="${1:-20}"
  case "$limit" in
    all) limit=999999 ;;
    *[!0-9]*|"") echo "$T_BAD_COUNT" >&2; return 1 ;;
  esac
  mkdir -p "$SUMMARY_DIR"
  local targets=() f
  while read -r f; do
    [ "${#targets[@]}" -ge "$limit" ] && break
    targets+=("$f")
  done < <(summary_targets)

  local total=${#targets[@]} i=0
  [ "$total" = 0 ] && { echo "$T_NOTHING_TO_SUMMARIZE"; return 0; }

  # Run the summarizer in the cache dir so it does not pick up a project's CLAUDE.md
  cd "$CCH_CACHE_DIR"
  # claude catches Ctrl-C and exits normally, so without this the loop would go on to the next conversation.
  # Stop the whole run instead, and re-raise the signal so the caller sees the interruption
  trap '[ -t 2 ] && printf "\r\033[K" >&2; trap - INT; kill -INT $$' INT
  local started=$SECONDS
  for f in "${targets[@]}"; do
    local id out dialogue title reply
    id=$(basename "$f" .jsonl)
    out="$SUMMARY_DIR/$id.txt"
    title=$(session_title "$f")
    title="${title:-$T_UNTITLED}"
    progress "$T_SUMMARIZING ($SUMMARY_MODEL_NAME)" "$i" "$total" "$started" "$title"
    [ -t 2 ] || echo "[$((i + 1))/$total] $title"
    i=$((i + 1))
    dialogue=$(extract_dialogue "$f")
    if [ -z "$dialogue" ]; then
      [ -t 2 ] && printf '\r\033[K' >&2
      echo "  $title: $T_NO_DIALOGUE"
      continue
    fi
    # For long conversations keep the beginning (goal) and the end (outcome), drop the middle
    if [ "${#dialogue}" -gt 30000 ]; then
      dialogue="${dialogue:0:8000}
...
${dialogue: -22000}"
    fi
    # Pin the role in the system prompt and wrap the transcript in tags, so the model summarizes it instead of replying to it
    # claude exits 0 even when the run fails or is interrupted (printing "Execution error"), so judge by is_error in the JSON result
    reply=$(printf '<transcript>\n%s\n</transcript>\n\n%s\n' "$dialogue" "$T_SUMMARY_REQUEST" \
      | claude -p --model "$SUMMARY_MODEL" --no-session-persistence --tools "" \
        --system-prompt "$T_SUMMARY_SYSTEM" --output-format json \
      | jq -r 'select(.is_error == false) | .result // empty' 2>/dev/null || true)
    if [ -n "$reply" ]; then
      # Normalize to 2-3 bullet lines even if the model drifts from the format
      printf '%s\n' "$reply" | sed -E 's/^[[:space:]]*([-*•・]|[0-9]+[.)])[[:space:]]*//; /^[[:space:]]*$/d' \
        | sed "s/^/$T_BULLET/" | head -3 > "$out"
    else
      [ -t 2 ] && printf '\r\033[K' >&2
      echo "  $title: $T_SUMMARY_FAILED" >&2
    fi
  done
  progress "$T_SUMMARIZING ($SUMMARY_MODEL_NAME)" "$total" "$total" "$started" "$T_DONE"
  [ -t 2 ] && echo >&2
  return 0
}


