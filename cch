#!/usr/bin/env bash
# List Claude Code conversations across all projects and resume the selected one in its directory
#   cch                    list all conversations, newest first
#   cch <word>             open with the conversations whose content contains <word>
#   cch -p [word]          print the list without opening fzf
#   cch summarize [count]  summarize conversations with no or stale summary, newest first (default 20, or all)
#   cch lang               choose the display language (en / ja / zh)
#   cch help               show help
#   cch --version          show the version
set -eu

CCH_VERSION="0.3.1"

# macOS ships BSD tools and Linux ships GNU ones; these wrappers hide the differences

# "mtime<TAB>path" for each file, as a command so xargs can run it too
if stat -c %Y / >/dev/null 2>&1; then
  MTIME_LIST=(stat -c $'%Y\t%n')
else
  MTIME_LIST=(stat -f $'%m\t%N')
fi

# Print lines last to first
reverse_lines() {
  if command -v tac >/dev/null 2>&1; then tac "$@"; else tail -r "$@"; fi
}

# Move files to the Trash: trash (macOS 14+, or trash-cli), then gio (GNOME/most Linux desktops), then trash-cli
move_to_trash() {
  if command -v trash >/dev/null 2>&1; then
    trash "$@"
  elif command -v gio >/dev/null 2>&1; then
    gio trash -- "$@"
  elif command -v trash-put >/dev/null 2>&1; then
    trash-put -- "$@"
  else
    echo "cch needs a trash command to delete: trash, gio (glib) or trash-put (trash-cli)" >&2
    return 1
  fi
}

# Runs before the language is chosen (the chooser itself needs fzf), so messages are English only
check_deps() {
  local missing=() pkgs=() c answer
  for c in fzf jq rg; do
    command -v "$c" >/dev/null 2>&1 && continue
    missing+=("$c")
    [ "$c" = rg ] && pkgs+=(ripgrep) || pkgs+=("$c")
  done
  if ! command -v claude >/dev/null 2>&1; then
    echo "cch needs Claude Code (the claude command): https://docs.claude.com/en/docs/claude-code" >&2
    exit 1
  fi
  [ "${#missing[@]}" = 0 ] && return 0

  echo "cch needs: ${missing[*]}" >&2
  if command -v brew >/dev/null 2>&1 && [ -t 0 ]; then
    read -r -s -n 1 -p "Install with 'brew install ${pkgs[*]}'? (Enter/y: yes, n: quit): " answer < /dev/tty
    echo
    if [ -z "$answer" ] || [ "$answer" = "y" ]; then
      brew install "${pkgs[@]}" && return 0
    fi
  else
    local pm
    for pm in brew apt dnf pacman zypper apk; do command -v "$pm" >/dev/null 2>&1 && break; pm=; done
    case "$pm" in
      brew) echo "Install them, e.g.: brew install ${pkgs[*]}" >&2 ;;
      pacman) echo "Install them, e.g.: sudo pacman -S ${pkgs[*]}" >&2 ;;
      ?*) echo "Install them, e.g.: sudo $pm install ${pkgs[*]}" >&2 ;;
      *) echo "Install them with your package manager (packages: ${pkgs[*]})" >&2 ;;
    esac
  fi
  exit 1
}

# fzf_at_least <major.minor>: whether the installed fzf is that version or later.
# Versions that cannot be parsed (such as dev builds) count as new enough
fzf_at_least() {
  local v major minor
  v=$(fzf --version 2>/dev/null) || return 0
  IFS=. read -r major minor _ <<< "${v%% *}"
  case "$major.$minor" in *[!0-9.]*|.*|*.) return 0 ;; esac
  [ "$major" -gt "${1%%.*}" ] || { [ "$major" -eq "${1%%.*}" ] && [ "$minor" -ge "${1#*.}" ]; }
}

# ctrl-t switches fields with change-nth (fzf 0.58) and picks the next field with transform (0.45).
# Older ones, such as 0.44 in Ubuntu 24.04 and 0.38 in Debian 12, run cch without ctrl-t;
# anything older than 0.38 has not been tried
FZF_MIN_VERSION=0.38
FZF_FULL_VERSION=0.58
check_fzf_version() {
  fzf_at_least "$FZF_MIN_VERSION" && return 0
  echo "cch needs fzf $FZF_MIN_VERSION or later (found $(fzf --version | cut -d' ' -f1))" >&2
  echo "Get the latest from https://github.com/junegunn/fzf/releases" >&2
  exit 1
}

case "${1:-}" in
  -v|--version|version) echo "cch $CCH_VERSION"; exit 0 ;;
  help|-h|--help) ;;
  # Internal commands run from inside fzf, so it was checked at launch
  __*) check_deps ;;
  *) check_deps; check_fzf_version ;;
esac

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/cch"
LANG_FILE="$CONFIG_DIR/lang"

choose_lang() {
  local choice
  choice=$(printf 'en\tEnglish\nja\t日本語\nzh\t中文（简体）\n' | fzf --delimiter=$'\t' --with-nth=2 \
    --height=~100% --reverse --no-info --prompt='Language> ' \
    --header='Choose the display language (change later with: cch lang)') || return 1
  mkdir -p "$CONFIG_DIR"
  echo "${choice%%$'\t'*}" > "$LANG_FILE"
}

# CCH_LANG > saved choice > ask on first interactive run > English
if [ -z "${CCH_LANG:-}" ]; then
  if [ "${1:-}" = "lang" ]; then
    choose_lang || true
    exit 0
  fi
  if [ ! -f "$LANG_FILE" ] && [ -t 0 ] && [ -t 1 ] && [ "${1:-}" != "-p" ] \
    && [ "${1:-}" != "help" ] && [ "${1:-}" != "-h" ] && [ "${1:-}" != "--help" ]; then
    choose_lang || true
  fi
  CCH_LANG=$(cat "$LANG_FILE" 2>/dev/null || echo en)
fi
