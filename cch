# Conversation files can be tens of MB, and a full-file regex scan with BSD grep takes ~0.7s each.
# For values where only the last one matters, read from the end and stop at the first match; use perl for full scans
json_field() {
  # $1: file, $2: type, $3: key to extract. Returns the last recorded value on one line.
  # Find the line with rg, then let jq decode it so quotes and backslashes come out right
  reverse_lines "$1" 2>/dev/null | rg -m1 -F "\"type\":\"$2\"" \
    | jq -r --arg k "$3" '.[$k] // empty | gsub("[\t\n\r]"; " ")' 2>/dev/null || true
}

list_sessions() {
  local files
  if [ -n "$QUERY" ]; then
    # A raw match is often inside tool output or base64 of pasted images and PDFs, so keep a file only
    # when the word is in a title or in the text of a prompt or reply. Images are never searched, and neither is
    # a text over 10000 characters, which is usually a whole page pasted in rather than the user's own words.
    # One pass over all files: ripgrep (about 10x faster than grep here) prints the matching lines after their
    # file name and a NUL. perl cheaply drops what cannot hold dialogue, so the bulk never reaches jq:
    # lines of other types, tool calls and tool results (each content block has its own line), and matches
    # only inside base64 strings (long runs with no spaces). jq then checks the text fields of what is left
    files=$(rg -F --null --no-messages -- "$QUERY" "$PROJECTS_DIR"/*/*.jsonl \
      | Q="$QUERY" perl -ne '
          next unless /"type":"(?:user|assistant|custom-title|ai-title)"/;
          next if /"type":"tool_(?:use|result)"/;
          my ($f, $l) = split /\0/, $_, 2;
          $l =~ s{"[A-Za-z0-9+/=]{200,}"}{""}g;
          next if index($l, $ENV{Q}) < 0;
          chomp $l; $f =~ s/(["\\])/\\$1/g;
          print qq({"f":"$f","l":$l}\n);' \
      | jq -Rr --arg q "$QUERY" '
          def texts: if type == "string" then . else (.[] | select(.type == "text") | .text) end;
          fromjson? | .f as $f | .l
          | if .type == "custom-title" then .customTitle
            elif .type == "ai-title" then .aiTitle
            elif (.type == "user" or .type == "assistant") and .isMeta != true then (.message.content | texts)
            else empty end
          | strings | select(length <= 10000 and contains($q)) | $f' \
      | sort -u || true)
  else
    files=$(ls "$PROJECTS_DIR"/*/*.jsonl 2>/dev/null || true)
  fi
  [ -z "$files" ] && return 0

  mkdir -p "$(dirname "$CACHE")"
  touch "$CACHE"
  ensure_prices
  local work
  work=$(mktemp -d)

  # Newest first by mtime: "mtime<TAB>path"
  echo "$files" | tr '\n' '\0' | xargs -0 "${MTIME_LIST[@]}" | sort -rn > "$work/list"

  # Only new or updated files are read again. Title and cost extraction is slow on large files,
  # and spawning commands per file adds up, so cached rows are joined in a single pass below
  # Compare FILENAME rather than NR == FNR, which breaks when the first file is empty (first run)
  awk -F'\t' 'FILENAME == ARGV[1] { cached[$1 "\t" $2] = 1; next } !(($2 "\t" $1) in cached) { print $2 "\t" $1 }' \
    "$CACHE" "$work/list" > "$work/stale"
  : > "$work/fresh"
  local stale_total stale_done=0 started=$SECONDS show=0
  stale_total=$(wc -l < "$work/stale" | tr -d ' ')
  # A bar only for long runs such as the first one; a few updated files finish instantly
  [ "${CCH_SHOW_PROGRESS:-0}" = 1 ] && [ "$stale_total" -ge 10 ] && show=1
  while IFS=$'\t' read -r f mtime; do
    [ "$show" = 1 ] && progress "$T_INDEXING" "$stale_done" "$stale_total" "$started"
    stale_done=$((stale_done + 1))
    local cwd
    cwd=$(grep -m1 -o '"cwd":"[^"]*"' "$f" | sed 's/"cwd":"//; s/"$//' || true)
    printf '%s\t%s\t%s\t%s\t%s\n' "$f" "$mtime" "$cwd" "$(session_title "$f")" "$(session_meta "$f")" >> "$work/fresh"
  done < "$work/stale"
  [ "$show" = 1 ] && printf '\r\033[K' >&2

  # New cache: fresh rows plus old rows for other files (e.g. those filtered out by a search word)
  awk -F'\t' 'FILENAME == ARGV[1] { seen[$1] = 1; print; next } !($1 in seen)' "$work/fresh" "$CACHE" > "$work/cache"
  mv "$work/cache" "$CACHE"

  # Cost and context size are shown dimmed to the right of the title
  T_UNTITLED="$T_UNTITLED" perl -MPOSIX=strftime -F'\t' -lane '
    BEGIN { $home = $ENV{HOME}; $cache_file = $ARGV[0] }
    if ($ARGV eq $cache_file) { $c{$F[0]} = [@F[2..4]]; next }
    my ($mtime, $f) = @F;
    my $row = $c{$f} or next;
    my ($cwd, $title, $meta) = @$row;
    next if $cwd eq "";
    (my $short = $cwd) =~ s/^\Q$home\E/~/;
    print join "\t", strftime("%m/%d %H:%M", localtime $mtime), $short,
      ($title ne "" ? $title : $ENV{T_UNTITLED}), $cwd, $f, "\e[2m" . ($meta // "") . "\e[0m";
  ' "$CACHE" "$work/list"
  rm -rf "$work"
}

session_title() {
  local t
  t=$(json_field "$1" custom-title customTitle)
  [ -z "$t" ] && t=$(json_field "$1" ai-title aiTitle)
  echo "$t"
}

ensure_prices() {
  # Use LiteLLM's public price table, as ccusage does. If it cannot be fetched, just omit the cost
  if [ ! -f "$PRICES" ] || [ -n "$(find "$PRICES" -mtime +7 2>/dev/null)" ]; then
    if curl -fsSL --max-time 10 "$PRICES_URL" -o "$PRICES.tmp" 2>/dev/null; then
      mv "$PRICES.tmp" "$PRICES"
    else
      rm -f "$PRICES.tmp"
    fi
  fi
}

# Returns "$1.23 · 116K": API-equivalent cost (including subagents) and the latest context size
session_meta() {
  local f="$1" usd ctx
  if [ -f "$PRICES" ]; then
    # One reply is split into several lines (one per content block) that repeat the same usage, so dedupe by message ID
    usd=$(cat "$f" "${f%.jsonl}"/subagents/*.jsonl 2>/dev/null | perl -ne 'print if /"type":"assistant"/' \
      | jq -rs --slurpfile p "$PRICES" '
        ($p[0]) as $P
        | map(select(.message.usage and .message.model != "<synthetic>"))
        | unique_by(.message.id + (.requestId // ""))
        | map(.message as $m | ($P[$m.model] // {}) as $r | $m.usage as $u
            | ($u.input_tokens // 0) * ($r.input_cost_per_token // 0)
            + ($u.output_tokens // 0) * ($r.output_cost_per_token // 0)
            + ($u.cache_read_input_tokens // 0) * ($r.cache_read_input_token_cost // 0)
            + ($u.cache_creation.ephemeral_5m_input_tokens // 0) * ($r.cache_creation_input_token_cost // 0)
            + ($u.cache_creation.ephemeral_1h_input_tokens // 0)
              * ($r.cache_creation_input_token_cost_above_1hr // $r.cache_creation_input_token_cost // 0))
        | (add // 0) * 100 | round
        | "$\(. / 100 | floor).\(. % 100 | tostring | if length < 2 then "0" + . else . end)"' 2>/dev/null || true)
  fi
  ctx=$(reverse_lines "$f" | grep -F '"type":"assistant"' | grep -v -m1 -F '"isSidechain":true' \
    | jq -r '.message.usage // empty
      | (.input_tokens // 0) + (.cache_read_input_tokens // 0) + (.cache_creation_input_tokens // 0)
      | if . >= 1000 then "\(. / 1000 | round)K" else tostring end' 2>/dev/null || true)
  if [ -n "$usd" ] && [ -n "$ctx" ]; then
    echo "$usd · $ctx"
  else
    echo "$usd$ctx"
  fi
}

# Format list rows. Wide (CJK) characters count as 2 columns; fields are truncated or padded to a fixed width
# In:  date / project / title / cwd / file / cost
# Out: date / project / title / cost / cwd / file
# Fields are tab-separated so fzf can filter per field. Each field is padded to one column short of a tab stop (multiple of 8) to keep columns aligned
format_rows() {
  perl -CSD -F'\t' -lane '
    sub width { my $n = 0; $n += /\p{Ea=W}|\p{Ea=F}/ ? 2 : 1 for split //, $_[0]; $n }
    sub fit {
      my ($s, $max) = @_;
      if (width($s) > $max) {
        my $o = "";
        for my $c (split //, $s) { last if width($o . $c) > $max - 1; $o .= $c }
        $s = $o . "\x{2026}";
      }
      $s . " " x ($max - width($s));
    }
    print join "\t", $F[0], fit($F[1], 23), fit($F[2], 39), $F[5] // "", $F[3], $F[4];
  '
}

# Called from ctrl-s in the list
summarize_from_list() {
  local total count answer
  total=$(summary_targets | wc -l | tr -d ' ')
  if [ "$total" = 0 ]; then
    echo "$T_NOTHING_TO_SUMMARIZE"
    sleep 1
    return 0
  fi
  count=$(( total < 20 ? total : 20 ))
  # shellcheck disable=SC2059
  printf "$T_SUMMARIZE_CONFIRM" "$total" "$SUMMARY_MODEL_NAME" "$count" "$total"
  # Unlike the single-key prompts, "all" has to be typed out: summarizing everything costs time and money.
  # Prompts read stdin, which is the terminal when fzf runs a binding, and can be fed by tests
  read -r answer || true
  case "$(echo "$answer" | tr '[:upper:]' '[:lower:]')" in
    ""|y) summarize "$count" ;;
    all) summarize all ;;
  esac
}

drop_cache_entry() {
  [ -f "$CACHE" ] || return 0
  awk -F'\t' -v f="$1" '$1 != f' "$CACHE" > "$CACHE.tmp" && mv "$CACHE.tmp" "$CACHE"
}

# Append a custom-title line, the same way Claude Code's /rename does
rename_session() {
  local f="$1" title ref rc=0
  # bash's read cannot be cancelled with Esc, so use fzf as the input field
  title=$(: | fzf --print-query --disabled --no-info --height=~100% --reverse \
    --query="$(session_title "$f")" --prompt="$T_RENAME_PROMPT" \
    --header="$T_RENAME_HEADER") || rc=$?
  # With no candidates, Enter exits with 1; Esc exits with 130
  [ "$rc" = 1 ] || return 0
  title=$(echo "$title" | head -1)
  [ -z "$title" ] && return 0
  # Restore mtime so that renaming alone does not move the conversation to the top
  ref=$(mktemp)
  touch -r "$f" "$ref"
  local id
  id=$(basename "$f" .jsonl)
  jq -cn --arg t "$title" --arg id "$id" '{type: "custom-title", customTitle: $t, sessionId: $id}' >> "$f"
  touch -r "$ref" "$f"
  rm -f "$ref"
  # mtime is unchanged, so drop the cache row or the old title would be reused
  drop_cache_entry "$f"
}

delete_session() {
  local f="$1" id answer
  id=$(basename "$f" .jsonl)
  local title
  title=$(session_title "$f")
  echo "$T_DELETE: ${title:-$T_UNTITLED}"
  echo "      $f"
  # Answer with a single key. Enter (an empty string for read) or y confirms; anything else, including Esc, cancels
  printf '%s' "$T_DELETE_CONFIRM"
  read -r -s -n 1 answer || true
  echo
  [ -z "$answer" ] || [ "$answer" = "y" ] || return 0
  move_to_trash "$f"
  # Subagent transcripts and tool results live in a directory named after the conversation
  [ -d "${f%.jsonl}" ] && move_to_trash "${f%.jsonl}"
  [ -f "$SUMMARY_DIR/$id.txt" ] && move_to_trash "$SUMMARY_DIR/$id.txt"
  drop_cache_entry "$f"
}

# PR URLs created in a conversation, latest first, at most 5. Records are chronological, so dedupe from the end
pr_urls() {
  perl -ne 'push @u, $1 while /"prUrl":"([^"]*)"/g;
    END { for (reverse @u) { next if $s{$_}++; print "$_\n"; last if ++$n == 5 } }' "$1"
}

# Preview for one conversation: $1 file, $2 working directory
preview_session() {
  local f="$1" d="$2" b s t="~"
  echo "dir    : ${d/#$HOME/$t}"
  # Claude Code records "HEAD" even outside git repositories, so hide it
  b=$(reverse_lines "$f" | grep -m1 -o '"gitBranch":"[^"]*"' | sed 's/.*:"//; s/"$//')
  if [ -n "$b" ] && [ "$b" != "HEAD" ]; then echo "branch : $b"; fi
  # Inside fzf's preview (FZF_PREVIEW_COLUMNS is set), draw PRs in orange as OSC 8 hyperlinks.
  # fzf takes mouse clicks for itself, so terminals open them with shift held (shift+cmd+click in Ghostty)
  local url
  pr_urls "$f" | while read -r url; do
    if [ -n "${FZF_PREVIEW_COLUMNS:-}" ]; then
      printf 'PR     : \033]8;;%s\033\\\033[1;38;2;255;150;100m%s\033[0m\033]8;;\033\\\n' "$url" "$url"
    else
      echo "PR     : $url"
    fi
  done
  echo
  s="$SUMMARY_DIR/$(basename "$f" .jsonl).txt"
  if [ -f "$s" ]; then
    echo "$CCH_L_SUMMARY"
    cat "$s"
    echo
  fi
  echo "$CCH_L_LAST_PROMPT"
  # GNU fold counts bytes and splits multibyte characters, so wrap at 80 display columns in perl
  last_prompt "$f" | perl -CSD -ne '
    chomp; my ($w, $o) = (0, "");
    for my $c (split //) {
      my $cw = $c =~ /\p{Ea=W}|\p{Ea=F}/ ? 2 : 1;
      if ($w + $cw > 80) { print "$o\n"; ($o, $w) = ("", 0) }
      $o .= $c; $w += $cw;
    }
    print "$o\n"'
}

# The latest message the user actually wrote.
# The last-prompt record is written at irregular times and can lag, so read user lines from the end instead.
# User-type lines also carry tool results (no text), notes injected by Claude Code (isMeta, or known tags),
# and summaries inserted by /compact; skip those. Messages sent while Claude is working are recorded as
# queued_command attachments instead. Pasted blocks are dropped in favor of the user's own words
last_prompt() {
  reverse_lines "$1" | rg -F -e '"type":"user"' -e '"queued_command"' | jq -nr '
    def injected: test("^<(task-notification|bash-input|bash-stdout|bash-stderr|local-command-stdout|local-command-stderr|local-command-caveat|command-name|command-message|command-args|system-reminder)[ >]");
    def trim_ws: sub("^\\s+"; "") | sub("\\s+$"; "");
    def text_of: if type == "string" then . else (map(select(.type == "text") | .text) | join("\n")) end;
    first(inputs
      | select(.isMeta != true and .isSidechain != true and .isCompactSummary != true)
      | if .type == "user" then (.message.content | text_of)
        elif .type == "attachment" and .attachment.type == "queued_command" then (.attachment.prompt // "" | text_of)
        else empty end
      | select(. != "" and (injected | not))
      | (gsub("(?s)<pasted_content[^>]*>.*?</pasted_content[^>]*>"; "") | trim_ws) as $own
      | if $own != "" then $own else (gsub("</?pasted_content[^>]*>"; "") | trim_ws) end
      | select(. != ""))' 2>/dev/null
}

# Internal commands invoked from fzf key bindings
case "${1:-}" in
  # In the content field the query is the search word; in the other fields fzf filters the full list itself.
  # With an older fzf there is no content field, and the word given at launch (CCH_FIXED_QUERY) stays
  __list)
    QUERY="${CCH_FIXED_QUERY:-}"
    [ "${FZF_PROMPT:-}" = "$CCH_P_CONTENT" ] && QUERY="${FZF_QUERY:-}"
    list_sessions | format_rows; exit 0 ;;
  __rename) rename_session "$2"; exit 0 ;;
  __delete) delete_session "$2"; exit 0 ;;
  __summarize) summarize_from_list; exit 0 ;;
  __preview) preview_session "$2" "$3"; exit 0 ;;
  summarize) shift; summarize "$@"; exit $? ;;
esac

if [ "$PRINT_ONLY" = 1 ]; then
  # GNU expand counts bytes, so wide characters would shift the columns; expand tabs by display width instead
  list_sessions | format_rows | cut -f1-4 | perl -CSD -pe '
    s/\e\[[0-9]*m//g;
    my $col = 0;
    s{([^\t]*)\t}{ $col += width($1); my $pad = 8 - $col % 8; $col += $pad; $1 . " " x $pad }ge;
    sub width { my $n = 0; $n += /\p{Ea=W}|\p{Ea=F}/ ? 2 : 1 for split //, $_[0]; $n }'
  exit 0
fi


SELF="$0"
export CCH_SELF="$SELF"

# Build the list before opening fzf so a long first run can show a progress bar
rows=$(CCH_SHOW_PROGRESS=1 list_sessions | format_rows)

# ctrl-t cycles title -> content -> date -> dir. The content field turns off fzf's own filtering and searches
# the conversations again on every change of the query; the prompt tells __list which field is active.
# fzf runs preview and binding commands with $SHELL; force bash because the commands use bash syntax.
# $FZF_PROMPT, $CCH_P_* and $CCH_SELF in these bindings are expanded by that shell, not here
# shellcheck disable=SC2016
if fzf_at_least "$FZF_FULL_VERSION"; then
  header="$T_HEADER"
  mode_opts=(
    --bind='ctrl-t:transform:case $FZF_PROMPT in
      "$CCH_P_TITLE") echo "change-prompt($CCH_P_CONTENT)+disable-search+reload(\"$CCH_SELF\" __list)" ;;
      "$CCH_P_CONTENT") echo "change-prompt($CCH_P_DATE)+change-nth(1)+enable-search+clear-query+reload(\"$CCH_SELF\" __list)" ;;
      "$CCH_P_DATE") echo "change-prompt($CCH_P_DIR)+change-nth(2)" ;;
      *) echo "change-prompt($CCH_P_TITLE)+change-nth(3)" ;;
    esac'
    --bind='change:transform:[ "$FZF_PROMPT" = "$CCH_P_CONTENT" ] && echo "reload(\"$CCH_SELF\" __list)" || true'
  )
  # Opened with a word, start in the content field with the word in the query
  start_opts=(--prompt="$CCH_P_TITLE")
  [ -n "$QUERY" ] && start_opts=(--prompt="$CCH_P_CONTENT" --query="$QUERY" --disabled)
else
  # Without ctrl-t only titles are filtered. mode_opts stays empty; bash 3.2 (macOS) needs the +
  # form to expand an empty array under set -u. A word given at launch narrows the list and stays for reloads
  # shellcheck disable=SC2059
  header="$T_HEADER_OLD"$'\n'"$(printf "$T_OLD_FZF" "$(fzf --version | cut -d' ' -f1)")"
  mode_opts=()
  start_opts=(--prompt="$CCH_P_TITLE")
  if [ -n "$QUERY" ]; then
    export CCH_FIXED_QUERY="$QUERY"
    # shellcheck disable=SC2059
    header+=$'\n'"$(printf "$T_FIXED_QUERY" "$QUERY")"
  fi
fi

selected=$(printf '%s\n' "$rows" | SHELL="$BASH" fzf \
  --ansi --delimiter=$'\t' --with-nth=1,2,3,4 --tabstop=8 --layout=reverse \
  --nth=3 "${start_opts[@]}" \
  --header="$header" \
  ${mode_opts[@]+"${mode_opts[@]}"} \
  --bind="ctrl-r:execute('$SELF' __rename {6})+reload('$SELF' __list)" \
  --bind="ctrl-x:execute('$SELF' __delete {6})+reload('$SELF' __list)" \
  --bind="ctrl-s:execute('$SELF' __summarize)+reload('$SELF' __list)+refresh-preview" \
  --preview="'$SELF' __preview {6} {5}" --preview-window=down,40%,wrap) || exit 0

cwd=$(echo "$selected" | cut -f5)
file=$(echo "$selected" | cut -f6)
session_id=$(basename "$file" .jsonl)

if [ ! -d "$cwd" ]; then
  echo "$T_DIR_MISSING: $cwd" >&2
  exit 1
fi

cd "$cwd"
exec claude -r "$session_id"
